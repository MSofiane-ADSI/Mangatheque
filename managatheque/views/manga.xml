<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="view_tree_manga" model="ir.ui.view">
    <field name="name">Manga liste</field>
    <field name="model">managatheque.managatheque</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="annee_parution"/>
            <field name="auteur"/>
        </list>
    </field>
</record>

<record id="view_form_manga" model="ir.ui.view">
    <field name="name">Manga Form</field>
    <field name="model">managatheque.managatheque</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="%(action_note_wizard)d" type="action"
                        string="Donner note" class="btn-primary"/>
            </header>
            <sheet>
                 <field name="image_couverture" widget="image" class="oe_avatar"/>
                <group col="2">
                    <field name="name"/>
                    <field name="annee_parution"/>
                    <field name="auteur"/>
                    <field name="note_texte" readonly="1"/>
                </group>
            </sheet>
               <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
               </chatter>
        </form>
    </field>
</record>

    <menuitem id="menu_manga" name="Mangathèque"/>

    <record id="action_manga_list" model="ir.actions.act_window">
        <field name="name">Liste des Mangass</field>
        <field name="res_model">managatheque.managatheque</field>
        <field name="view_mode">list,form</field>
    </record>
    


    <menuitem id="menu_manga_list"
              name="Liste des Mangas"
              parent="managatheque.menu_manga" 
              action="managatheque.action_manga_list"/>


    <record id="action_report_manga" model="ir.actions.report">
        <field name="name">Fiche Manga</field>
        <field name="model">managatheque.managatheque</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">managatheque.report_manga_document</field>
        <field name="print_report_name">'Manga - %s' % object.name</field>
        <field name="binding_model_id" ref="model_managatheque_managatheque"/>
        <field name="binding_type">report</field>
    </record>
</odoo>